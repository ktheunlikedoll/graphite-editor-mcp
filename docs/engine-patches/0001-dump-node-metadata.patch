+		Command::DumpNodeMetadata => {
+			// Full registry dump for tooling: one JSON object per line keeps streaming/parse
+			// simple and avoids buffering the whole registry in one string.
+			use graphene_std::registry::{FieldMetadata, NodeMetadata, RegistryValueSource};
+
+			fn field_json(field: &FieldMetadata) -> serde_json::Value {
+				let mut f = serde_json::json!({
+					"name": field.name,
+					"description": field.description,
+				});
+				if field.hidden {
+					f["hidden"] = serde_json::json!(true);
+				}
+				if let Some(t) = &field.default_type {
+					f["type"] = serde_json::json!(t.to_string());
+				}
+				if let RegistryValueSource::Default(expr) = field.value_source {
+					if !expr.is_empty() {
+						f["default"] = serde_json::json!(expr);
+					}
+				}
+				if let (Some(lo), Some(hi)) = (field.number_soft_min, field.number_soft_max) {
+					f["softRange"] = serde_json::json!([lo, hi]);
+				}
+				if let (Some(lo), Some(hi)) = (field.number_hard_min, field.number_hard_max) {
+					f["hardRange"] = serde_json::json!([lo, hi]);
+				}
+				if let Some(step) = field.number_step {
+					f["step"] = serde_json::json!(step);
+				}
+				if let Some(unit) = field.unit {
+					f["unit"] = serde_json::json!(unit);
+				}
+				f
+			}
+
+			fn node_json(identifier: &str, meta: &NodeMetadata) -> serde_json::Value {
+				serde_json::json!({
+					"identifier": identifier,
+					"displayName": meta.display_name,
+					"category": meta.category,
+					"description": meta.description,
+					"fields": meta.fields.iter().map(field_json).collect::<Vec<_>>(),
+				})
+			}
+
+			let registry = graphene_std::registry::NODE_METADATA.lock().unwrap();
+			let mut identifiers: Vec<_> = registry.keys().cloned().collect();
+			identifiers.sort_by_key(|x| x.as_str().to_string());
+			for id in identifiers {
+				if let Some(meta) = registry.get(&id) {
+					let line = serde_json::to_string(&node_json(id.as_str(), meta)).expect("metadata is JSON-serializable");
+					println!("{line}");
+				}
+			}
+			return Ok(());
+		}
 	};
 
